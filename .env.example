# DATABASE_URL: PostgreSQL connection string (with the pgvector extension enabled).
# For local dev with zero setup: run `npx tsx scripts/local-postgres.ts` (embedded Postgres+pgvector,
# no Docker/account needed) and use the value below, unchanged.
# For production: any real Postgres with pgvector (Supabase/Neon both work) — run
# `create extension if not exists vector;` once in its SQL editor, then load db/init/001_schema.sql.
DATABASE_URL="postgres://postgres@127.0.0.1:5432/postgres"

# MinIO (S3-compatible raw file storage). Run bin/minio.exe locally (see scripts/start-minio.*),
# or point these at any S3-compatible endpoint (including real AWS S3) when deploying.
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="billslayer"
MINIO_ROOT_PASSWORD="billslayer_dev_pw"
MINIO_BUCKET="billslayer-case-files"

# APP_URL: The URL where this applet is hosted. Used for self-referential links.
APP_URL="MY_APP_URL"

# Email Configuration for OTP Verification
EMAIL_USER=
EMAIL_PASS=

# Optional Custom SMTP settings (defaults to Gmail smtp.gmail.com:465)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
